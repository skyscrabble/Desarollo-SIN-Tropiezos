([mitologia_Class3] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Restringe que ningún Personaje pueda matar a otro si, para cualquiera de ellos su estado_vida == muerto.")
	(%3APAL-NAME "AmbosPersonajesVivosParaMatar")
	(%3APAL-RANGE "(defrange ?accion :FRAME Matar)")
	(%3APAL-STATEMENT "(forall ?accion\n        (=> (and (own-slot-not-null sujeto ?accion)\n                 (own-slot-not-null destino ?accion))\n            (and (= (estado_vida (sujeto ?accion)) vivo)\n                 (= (estado_vida (destino ?accion)) vivo))\n        )\n)"))
