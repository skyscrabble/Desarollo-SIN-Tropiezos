;+ (version "3.4.8")
;+ (build "Build 629")

([mitologia_Class0] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Restringe que ningún Personaje pueda tener el valor del atributo estado_vida == vivo y estado_vida == muerto. Aunque el slot esté especificado como Symbol con esos valores, se añade la restricción por consistencia.")
	(%3APAL-NAME "NadieVivoYMuerto")
	(%3APAL-RANGE "(defrange ?p :FRAME Personaje)")
	(%3APAL-STATEMENT "(forall ?p\n        (not (and (= (estado_vida ?p) vivo)\n                  (= (estado_vida ?p) muerto)))\n)"))

([mitologia_Class1] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Restringe que ningún Personaje pueda tenerse a sí mismo en el valor de su slot es_padre_o_madre.")
	(%3APAL-NAME "NadieEsSuPropioPadreOMadre")
	(%3APAL-RANGE "(defrange ?p :FRAME Personaje)")
	(%3APAL-STATEMENT "(forall ?p\n        (not (= (es_padre_o_madre ?p) ?p))\n)"))

([mitologia_Class10000] of  Dios

	(estado_libertad libre)
	(estado_vida vivo)
	(nombre "Poseidon"))

([mitologia_Class10001] of  Humano

	(es_padre_o_madre [mitologia_Class10005])
	(estado_libertad libre)
	(estado_vida vivo)
	(nombre "Casiopea")
	(tiene_enojo [mitologia_Class10000]))

