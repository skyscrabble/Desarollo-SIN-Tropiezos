package reglas

import clases.*;
import clases.personajes.*;
import clases.relaciones.*;
import clases.acciones.*;
import com.mitologia.Mision;

global java.util.List salida;

rule "Informacion inicial: personajes"
    agenda-group "Informacion Inicial"
    when
        $p : Personaje()
    then
        System.out.println( $p.nombre + " | vivo: " + $p.estado_vida + " | libre: " + $p.estado_libertad );
end

rule "Informacion inicial: posesiones"
    agenda-group "Informacion Inicial"
    when
        TieneObjeto( $p : personaje, $o : objeto )
    then
        System.out.println( $p.nombre + " posee " + $o.nombre );
end

rule "Informacion inicial: favores"
    agenda-group "Informacion Inicial"
    when
        TieneFavor( $p : personaje, $d : dios )
    then
        System.out.println( $p.nombre + " tiene el favor de " + $d.nombre );
end

rule "Informacion inicial: enojos"
    agenda-group "Informacion Inicial"
    when
        TieneEnojo( $p : personaje, $e : personajeEnojado )
    then
        System.out.println( $p.nombre + " tiene el enojo de " + $e.nombre );
end

rule "Informacion inicial: mision"
    agenda-group "Informacion Inicial"
    when
        $m : Mision()
    then
        System.out.println( "Mision: " + $m.tipo + " sujeto=" + $m.sujeto.nombre );
end

rule "Un dios entrega sus objetos a quien tiene su favor"
    no-loop true
    when
        TieneFavor( $p : personaje, $d : dios )
        $t : TieneObjeto( personaje.nombre == $d.nombre, $o : objeto )
        not TieneObjeto( personaje.nombre == $p.nombre, objeto.nombre == $o.nombre )
    then
        delete( $t );
        insert( new TieneObjeto( $p, $o ) );
        salida.add( $p.nombre + " obtiene " + $o.nombre + " debido a tener el favor de " + $d.nombre + "." );
end

rule "Poseer un objeto otorga su capacidad"
    no-loop true
    salience 80
    when
        TieneObjeto( $p : personaje, $o : objeto )
        OtorgaCapacidad( objeto == $o, $c : capacidad )
        not TieneCapacidad( personaje.nombre == $p.nombre, capacidad.nombre == $c.nombre )
    then
        insertLogical( new TieneCapacidad( $p, $c ) );
        System.out.println( $p.nombre + " obtiene la capacidad " + $c.nombre
            + " debido a tener " + $o.nombre );
end


rule "Mision OBJETO alcanzada"
    no-loop true
    salience 0
    when
        $m : Mision( tipo == Mision.Tipo.OBJETO, $h : sujeto,
                     $o : objetivoObjeto, alcanzada == false )
        TieneObjeto( personaje == $h, objeto == $o )
    then
        modify( $m ) { setAlcanzada( true ) }
        salida.add( "Mision cumplida: " + $h.nombre + " obtiene " + $o.nombre );
end

rule "Mision CAPACIDAD alcanzada"
    no-loop true
    salience 0
    when
        $m : Mision( tipo == Mision.Tipo.CAPACIDAD, $h : sujeto,
                     $c : objetivoCapacidad, alcanzada == false )
        TieneCapacidad( personaje == $h, capacidad == $c )
    then
        modify( $m ) { setAlcanzada( true ) }
        salida.add( "Mision cumplida: " + $h.nombre + " obtiene la capacidad " + $c.nombre );
end

rule "Mision MATAR alcanzada"
    no-loop true
    salience 0
    when
        $m : Mision(tipo == Mision.Tipo.MATAR, alcanzada == false, 
                    $sujeto : sujeto, $objetivo : objetivoPersonaje)
        $accion : Matar(sujeto == $sujeto)
        AccionDestinoPersonaje(accion == $accion, destino == $objetivo)
        Personaje(this == $objetivo, estado_vida == false)
    then
        modify($m) {
            setAlcanzada(true)
        }
        salida.add("Mision cumplida: " + $sujeto.nombre + " mata a " + $objetivo.nombre);
end

rule "Mision APRESAR alcanzada"
    no-loop true
    salience 0
    when
        $m : Mision(tipo == Mision.Tipo.APRESAR, alcanzada == false, 
                    $sujeto : sujeto, $objetivo : objetivoPersonaje)
        $accion : Apresar(sujeto == $sujeto)
        AccionDestinoPersonaje(accion == $accion, destino == $objetivo)
        Personaje(this == $objetivo, estado_vida == true, estado_libertad == false)
    then
        modify($m) {
            setAlcanzada(true)
        }
        salida.add("Mision cumplida: " + $sujeto.nombre + " apresa a " + $objetivo.nombre);
end

rule "Mision LIBERAR alcanzada"
    no-loop true
    salience 0
    when
        $m : Mision(tipo == Mision.Tipo.LIBERAR, alcanzada == false, 
                    $sujeto : sujeto, $objetivo : objetivoPersonaje)
        $accion : Liberar(sujeto == $sujeto)
        AccionDestinoPersonaje(accion == $accion, destino == $objetivo)
        Personaje(this == $objetivo, estado_vida == true, estado_libertad == true)
    then
        modify($m) {
            setAlcanzada(true)
        }
        salida.add("Mision cumplida: " + $sujeto.nombre + " libera a " + $objetivo.nombre);
end



rule "Poseidon envia a Ceto a apresar a Andromeda"
    no-loop true
    when
        $enojo : TieneEnojo( personaje.nombre == "Casiopea", personajeEnojado.nombre == "Poseidon" )
        $andromeda : Personaje( nombre == "Andromeda", estado_libertad == true )
        $m : Mision( alcanzada == false )
    then
        modify( $andromeda ) { estado_libertad = false }
        delete( $enojo );
        salida.add( "Poseidon, enojado con Casiopea, envia al monstruo Ceto a apresar a Andromeda." );
end

rule "Un heroe localiza a las Grayas"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $hermes : Dios( nombre == "Hermes" )
        $atenea : Dios( nombre == "Atenea" )
        TieneFavor( personaje == $heroe, dios == $hermes )
        TieneFavor( personaje == $heroe, dios == $atenea )
        $grayas : Criatura( nombre == "Grayas" )
        not ( Localizar( $l : this, sujeto == $heroe )
              and AccionDestinoPersonaje( accion == $l, destino == $grayas ) )
    then
        Localizar $loc = new Localizar();
        $loc.setSujeto( $heroe );
        insert( $loc );
        insert( new AccionDestinoPersonaje( $loc, $grayas ) );
        salida.add( $heroe.nombre + " localiza a las Grayas debido a tener el favor de Hermes y Atenea." );
end

rule "Un heroe roba el Ojo de las Grayas"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $inv : Capacidad( nombre == "Invisibilidad" )
        TieneCapacidad( personaje == $heroe, capacidad == $inv )
        $grayas : Criatura( nombre == "Grayas" )
        $loc : Localizar( sujeto == $heroe )
        AccionDestinoPersonaje( accion == $loc, destino == $grayas )
        $ojo : Objeto( nombre == "Ojo de las Grayas" )
        $t : TieneObjeto( personaje == $grayas, objeto == $ojo )
        not Intercambiar( sujeto == $heroe )
    then
        delete( $t );
        insert( new TieneObjeto( $heroe, $ojo ) );
        salida.add( $heroe.nombre + " roba el Ojo de las Grayas debido a tener Invisibilidad y las Grayas localizadas." );
end

rule "Un heroe intercambia el ojo y localiza a las Ninfas"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $grayas : Criatura( nombre == "Grayas" )
        $ninfas : Criatura( nombre == "Ninfas" )
        $ojo : Objeto( nombre == "Ojo de las Grayas" )
        $t : TieneObjeto( personaje == $heroe, objeto == $ojo )
        not Intercambiar( sujeto == $heroe )
    then
        delete( $t );
        insert( new TieneObjeto( $grayas, $ojo ) );
        Intercambiar $i = new Intercambiar();
        $i.setSujeto( $heroe );
        insert( $i );
        insert( new AccionDestinoPersonaje( $i, $grayas ) );
        Localizar $loc = new Localizar();
        $loc.setSujeto( $heroe );
        insert( $loc );
        insert( new AccionDestinoPersonaje( $loc, $ninfas ) );
        salida.add( $heroe.nombre + " localiza a las Ninfas debido a intercambiar el Ojo de las Grayas con las Grayas." );
end

rule "Las Ninfas entregan sus objetos a quien las localiza"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $ninfas : Criatura( nombre == "Ninfas" )
        $loc : Localizar( sujeto == $heroe )
        AccionDestinoPersonaje( accion == $loc, destino == $ninfas )
        $t : TieneObjeto( personaje == $ninfas, $o : objeto )
    then
        delete( $t );
        insert( new TieneObjeto( $heroe, $o ) );
        salida.add( $heroe.nombre + " obtiene " + $o.nombre + " debido a tener a las Ninfas localizadas." );
end

rule "Un heroe mata a Medusa"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $medusa : Personaje( nombre == "Medusa", estado_vida == true )
        TieneCapacidad( personaje == $heroe, capacidad.nombre == "Vuelo" )
        TieneCapacidad( personaje == $heroe, capacidad.nombre == "Invisibilidad" )
        TieneObjeto( personaje == $heroe, objeto.nombre == "Escudo de Bronce" )
        TieneObjeto( personaje == $heroe, objeto.nombre == "Hoz de Acero" )
        TieneObjeto( personaje == $heroe, objeto.nombre == "Zurron Magico" )
    then
        modify( $medusa ) { setEstado_vida( false ) }
        Objeto cabeza = new Objeto( "Cabeza de Medusa" );
        insert( cabeza );
        insert( new TieneObjeto( $heroe, cabeza ) );
        salida.add( $heroe.nombre + " contempla a Medusa a traves del reflejo del Escudo de Bronce, la decapita con la Hoz de Acero y guarda la Cabeza de Medusa en el Zurron Magico." );
end

rule "Un heroe mata a Ceto"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $ceto : Criatura( nombre == "Ceto", estado_vida == true )
        Apresar( sujeto == $ceto )
        $vuelo : Capacidad( nombre == "Vuelo" )
        $pet : Capacidad( nombre == "Petrificar" )
        TieneCapacidad( personaje == $heroe, capacidad == $vuelo )
        TieneCapacidad( personaje == $heroe, capacidad == $pet )
    then
        modify( $ceto ) { setEstado_vida( false ) }
        Matar $m = new Matar();
        $m.setSujeto( $heroe );
        insert( $m );
        insert( new AccionDestinoPersonaje( $m, $ceto ) );
        salida.add( $heroe.nombre + " mata a Ceto debido a tener la capacidad Petrificar." );
end

rule "Matar al captor libera a su victima"
    no-loop true
    when
        $m : Matar( $h : sujeto )
        AccionDestinoPersonaje( accion == $m, $captor : destino )
        $ap : Apresar( sujeto == $captor )
        AccionDestinoPersonaje( accion == $ap, $v : destino )
        $victima : Personaje( this == $v, estado_libertad == false, estado_vida == true )
    then
        modify( $victima ) { setEstado_libertad( true ) }
        Liberar $l = new Liberar();
        $l.setSujeto( $h );
        insert( $l );
        insert( new AccionDestinoPersonaje( $l, $v ) );
        salida.add( $h.nombre + " libera a " + $v.nombre + " debido a matar a " + $captor.nombre + "." );
end


rule "Un heroe mata al Minotauro"
    no-loop true
    when
        $heroe : Personaje( estado_vida == true, estado_libertad == true )
        eval( $heroe instanceof Heroe || $heroe instanceof Semidios )
        $minotauro : Criatura( nombre == "Minotauro", estado_vida == true )
        $loc : Localizar( sujeto == $heroe )
        AccionDestinoPersonaje( accion == $loc, destino == $minotauro )
        $arma : Capacidad( nombre == "Arma" )
        $fuerza : Capacidad( nombre == "Fuerza" )
        ( TieneCapacidad( personaje == $heroe, capacidad == $arma )
          or TieneCapacidad( personaje == $heroe, capacidad == $fuerza ) )
    then
        modify( $minotauro ) { setEstado_vida( false ) }
        Matar $m = new Matar();
        $m.setSujeto( $heroe );
        insert( $m );
        insert( new AccionDestinoPersonaje( $m, $minotauro ) );
        salida.add( $heroe.nombre + " se adentra en el laberinto y mata al Minotauro." );
end


rule "Un heroe libera a un prisionero del Minotauro"
    no-loop true
    when
        $libertador : Personaje( estado_libertad == true )
        $prisionero : Personaje( estado_libertad == false, nombre != "Minotauro", nombre != "Ceto", nombre != "Kraken", nombre != "Andromeda", nombre != "Dedalo", nombre != "Icaro" )
        $minotauro : Personaje( nombre == "Minotauro" )
        $loc : Localizar( sujeto == $libertador )
        AccionDestinoPersonaje( accion == $loc, destino == $minotauro )
    then
        modify( $prisionero ) { estado_libertad = true }
        
        Liberar accion = new Liberar();
        accion.setSujeto($libertador);
        insert( accion );
        insert( new AccionDestinoPersonaje(accion, $prisionero) );
        
        salida.add( $libertador.nombre + " localiza la guarida del Minotauro y libera a " + $prisionero.nombre + "." );
end

rule "Dedalo fabrica las Alas con Cera y Plumas"
    no-loop true
    when
        $dedalo : Personaje( nombre == "Dedalo", estado_libertad == false, estado_vida == true )
        $icaro : Personaje( nombre == "Icaro", estado_libertad == false, estado_vida == true )
        $cera : Objeto( nombre == "Cera de Abejas" )
        $plumas : Objeto( nombre == "Plumas de Aves" )
        $alasD : Objeto( nombre == "Alas de Dedalo" )
        $alasI : Objeto( nombre == "Alas de Icaro" )
        TieneObjeto( personaje == $dedalo, objeto == $cera )
        TieneObjeto( personaje == $dedalo, objeto == $plumas )
        not TieneObjeto( personaje == $dedalo, objeto == $alasD )
    then
        insert( new TieneObjeto( $dedalo, $alasD ) );
        insert( new TieneObjeto( $icaro, $alasI ) );
        Fabricar $f = new Fabricar();
        $f.setSujeto( $dedalo );
        insert( $f );
        salida.add( "Dedalo fabrica las Alas de Dedalo y las Alas de Icaro con Cera de Abejas y Plumas de Aves." );
end

rule "Icaro muere al intentar escapar volando"
    no-loop true
    when
        $icaro : Personaje( nombre == "Icaro", estado_libertad == false, estado_vida == true )
        $alasI : Objeto( nombre == "Alas de Icaro" )
        $t : TieneObjeto( personaje == $icaro, objeto == $alasI )
    then
        modify( $icaro ) { setEstado_vida( false ) }
        delete( $t );
        salida.add( "Icaro intenta escapar volando pero se acerca demasiado al sol y muere; las Alas de Icaro quedan donde cae." );
end

rule "Dedalo escapa del laberinto volando"
    no-loop true
    when
        $dedalo : Personaje( nombre == "Dedalo", estado_libertad == false, estado_vida == true )
        $alasD : Objeto( nombre == "Alas de Dedalo" )
        TieneObjeto( personaje == $dedalo, objeto == $alasD )
    then
        modify( $dedalo ) { setEstado_libertad( true ) }
        Escapar $e = new Escapar();
        $e.setSujeto( $dedalo );
        insert( $e );
        salida.add( "Dedalo utiliza sus alas para escapar del laberinto." );
end

rule "Minos encierra a Dedalo e Icaro cuando muere el Minotauro"
    no-loop true
    when
        $minos : Humano( nombre == "Minos" )
        Criatura( nombre == "Minotauro", estado_vida == false )
        $dedalo : Humano( nombre == "Dedalo", estado_libertad == true )
        $icaro : Humano( nombre == "Icaro", estado_libertad == true )
        not Apresar( sujeto == $minos )
    then
        modify( $dedalo ) { setEstado_libertad( false ) }
        modify( $icaro ) { setEstado_libertad( false ) }
        Apresar $a1 = new Apresar();
        $a1.setSujeto( $minos );
        insert( $a1 );
        insert( new AccionDestinoPersonaje( $a1, $dedalo ) );
        Apresar $a2 = new Apresar();
        $a2.setSujeto( $minos );
        insert( $a2 );
        insert( new AccionDestinoPersonaje( $a2, $icaro ) );
        salida.add( "Minos, enfadado por la muerte del Minotauro, encierra a Dedalo y a Icaro en el laberinto." );
end

                 