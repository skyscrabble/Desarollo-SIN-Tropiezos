(defclass Humano "Representación de un personaje humano o mortal. Extraído del enunciado del proyecto de practicas."
	(is-a Personaje)
	(role concrete))

(defclass Semidios "Representación de un personaje nacido de la unión entre un Dios y un Humano. Extraído del enunciado del proyecto de practicas."
	(is-a Personaje)
	(role concrete))

(defclass Dios "Representación de un personaje inmortal y poderoso. Extraído del enunciado del proyecto de practicas."
	(is-a Personaje)
	(role concrete))

(defclass Heroe "Representación de un personaje intermedio entre un Humano y un Dios, caracterizado por realizar hazañas extraordinarias y buscar la gloria inmortal. Extraído de Gemini."
	(is-a Personaje)
	(role concrete))

(defclass Criatura "Representación de un personaje fantástico, híbrido o monstruoso. Extraído del enunciado de la práctica."
	(is-a Personaje)
	(role concrete))

(defclass Objeto "Representa un artilugio relevante para el desarrollo de los mitos."
	(is-a USER)
	(role concrete)
	(single-slot nombre
;+		(comment "Identificador de texto único para nombrar al elemento o personaje de la ontología.")
		(type STRING)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(single-slot ubicacion_actual
;+		(comment "Relación que vincula a un Personaje u Objeto con el lugar físico donde se encuentra en este momento.")
		(type INSTANCE)
;+		(allowed-classes Ubicacion)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass Capacidad "Representa un poder o habilidad relevante para el desarrollo del mito. No se modela cada una de las subcapacidades concretas, sino que se modelan como atributo de Capacidad."
	(is-a USER)
	(role concrete)
	(single-slot nombre
;+		(comment "Identificador de texto único para nombrar al elemento o personaje de la ontología.")
		(type STRING)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass Ubicacion "Representa la localización de una entidad como un Personaje o un Objeto."
	(is-a USER)
	(role concrete)
	(single-slot nombre
;+		(comment "Identificador de texto único para nombrar al elemento o personaje de la ontología.")
		(type STRING)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass Accion "Superclase que representa un evento dinámico o suceso ejecutado por un Personaje durante el transcurso del mito, que puede involucrar a otro Personaje u Objeto."
	(is-a USER)
	(role abstract)
	(multislot destino
;+		(comment "Personaje u Objeto hacia el que va dirigida la relación.")
		(type INSTANCE)
;+		(allowed-classes Personaje Objeto)
		(cardinality 1 ?VARIABLE)
		(create-accessor read-write))
	(multislot sujeto
;+		(comment "Personaje o entidad principal que inicia la relación o posee el vínculo.")
		(type INSTANCE)
;+		(allowed-classes Personaje)
		(cardinality 1 ?VARIABLE)
		(create-accessor read-write)))

(defclass Apresar "Acción mediante la cual una criatura o personaje captura y priva de libertad a otro."
	(is-a Accion)
	(role concrete))

(defclass Matar "Acción final en la que un personaje arrebata la vida a otro para cumplir una misión."
	(is-a Accion)
	(role concrete))

(defclass Liberar "Acción heroica en la que un personaje rescata a otro que se encontraba apresado."
	(is-a Accion)
	(role concrete))

(defclass Intercambiar "Acción de dar un objeto a cambio de información, otro objeto o un servicio."
	(is-a Accion)
	(role concrete))

(defclass Localizar "Acción de encontrar la ubicación exacta de un personaje, objeto o criatura para poder interactuar con él."
	(is-a Accion)
	(role concrete))