([mitologia_Class30001] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Restringe que ningun Personaje pueda tener simultaneamente el favor y el enojo de un mismo Dios.")
	(%3APAL-NAME "IncompatibilidadFavorYEnojo")
	(%3APAL-RANGE "(defrange ?p :FRAME Personaje)\n(defrange ?d :FRAME Dios)")
	(%3APAL-STATEMENT "(forall ?p\n        (forall ?d\n                (not (and (tiene_favor ?p ?d)\n                          (tiene_enojo ?p ?d)))\n        )\n)"))

([mitologia_Class30002] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Garantiza que un mismo Objeto fisico no pueda estar en posesion de dos Personajes distintos simultaneamente.")
	(%3APAL-NAME "ObjetoUnicoPoseedor")
	(%3APAL-RANGE "(defrange ?p1 :FRAME Personaje)\n(defrange ?p2 :FRAME Personaje)\n(defrange ?obj :FRAME Objeto)")
	(%3APAL-STATEMENT "(forall ?p1\n        (forall ?p2\n                (forall ?obj\n                        (=> (and (posee_objeto ?p1 ?obj)\n                                 (posee_objeto ?p2 ?obj))\n                            (= ?p1 ?p2))\n                )\n        )\n)"))
